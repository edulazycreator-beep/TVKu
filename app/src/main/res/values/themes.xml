<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TVKu" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tvku_background</item>
        <item name="android:colorBackground">@color/tvku_background</item>
        <item name="android:colorAccent">@color/tvku_accent</item>
    </style>

    <style name="Theme.TVKu.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tvku_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TVKu</item>
    </style>
</resources>
